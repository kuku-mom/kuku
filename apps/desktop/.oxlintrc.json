{
  "$schema": "../..//node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "ignorePatterns": ["**/dist"],
  "overrides": [
    {
      "files": ["**/*.{js,cjs,mjs,ts,tsx,cts,mts}"],
      "jsPlugins": ["eslint-plugin-better-tailwindcss"],
      "rules": {
        // ── better-tailwindcss recommended (stylistic: warn) ──
        "better-tailwindcss/enforce-consistent-line-wrapping": "off",
        "better-tailwindcss/enforce-consistent-class-order": "warn",
        // ── conflict with 'enforce-canonical-classes'
        "better-tailwindcss/enforce-consistent-variable-syntax": "off",
        "better-tailwindcss/enforce-consistent-important-position": "off",
        "better-tailwindcss/enforce-shorthand-classes": "off",
        // ── end: conflict with 'enforce-canonical-classes'
        "better-tailwindcss/enforce-canonical-classes": "warn",
        "better-tailwindcss/no-duplicate-classes": "error",
        "better-tailwindcss/no-deprecated-classes": "warn",
        "better-tailwindcss/no-unnecessary-whitespace": "warn",
        // ── better-tailwindcss recommended (correctness: error) ──
        "better-tailwindcss/no-unknown-classes": [
          "error",
          {
            "ignore": [
              "^tab-bar(-tabs)?$",
              // Explicit plugin-owned selectors in planner.css.
              "^(?:kuku-task-date|planner|planner-actions|planner-add-details|planner-all-day|planner-all-day-event|planner-all-day-preview|planner-block|planner-block-body|planner-block-compact|planner-block-dragging|planner-block-overlap|planner-block-overlap-mark|planner-block-pending|planner-block-readonly|planner-calendar|planner-calendar-alias|planner-calendar-choice|planner-calendar-heading|planner-capture|planner-capture-heading|planner-checkbox-field|planner-compact-bar|planner-composer|planner-composer-hint|planner-composer-space|planner-connection|planner-content|planner-danger-button|planner-date-entry|planner-date-error|planner-date-grid|planner-date-header|planner-date-popup|planner-date-today|planner-date-trigger|planner-date-week|planner-day-column|planner-day-headings|planner-day-picker|planner-delete-confirm|planner-dialog|planner-dialog-body|planner-dialog-title|planner-disclosure-chevron|planner-drag-overlap|planner-drag-preview|planner-drag-time|planner-due|planner-duration-presets|planner-empty|planner-error|planner-error-banner|planner-event-block|planner-field|planner-filter-field|planner-filters|planner-floating-card|planner-floating-compact|planner-floating-in-calendar|planner-floating-origin|planner-floating-settling|planner-form-grid|planner-glyph|planner-grid-hint|planner-header|planner-heading|planner-hours|planner-icon-button|planner-is-complete|planner-is-dragging|planner-is-resizing|planner-is-today|planner-kind-picker|planner-link-metadata|planner-link-picker|planner-linked-note-label|planner-list-scroll|planner-main|planner-muted|planner-new-event|planner-next-event|planner-note-link|planner-note-results|planner-now-button|planner-now-label|planner-now-line|planner-operation-list|planner-overdue-heading|planner-overlap-notice|planner-panel|planner-panel-actions|planner-panel-description|planner-panel-detail|planner-panel-empty|planner-panel-meta|planner-panel-note|planner-panel-row|planner-panel-section|planner-panel-shell|planner-panel-status|planner-plan-total|planner-preview-carry|planner-preview-draft|planner-preview-saving|planner-primary|planner-quick-add|planner-reminder|planner-resize|planner-resize-top|planner-screen-reader|planner-select|planner-select-check|planner-select-chevron|planner-select-content|planner-select-description|planner-select-item|planner-select-label|planner-select-list|planner-select-trigger|planner-select-value|planner-settings|planner-settings-icon|planner-settings-label|planner-slot-context|planner-slot-options|planner-slot-refresh|planner-slot-status|planner-slot-suggestions|planner-slot-toggle|planner-source-dot|planner-source-picker|planner-source-stale|planner-source-status|planner-source-strip|planner-source-tag|planner-task|planner-task-actions|planner-task-block|planner-task-controls|planner-task-copy|planner-task-count|planner-task-lifted|planner-task-list|planner-task-path|planner-task-query|planner-task-search|planner-task-search-clear|planner-task-sort|planner-task-status|planner-task-title|planner-text-button|planner-time-grid|planner-timezone|planner-undo-notice|planner-week|planner-week-cue|planner-week-inner|planner-week-scroll|planner-week-snapshot|planner-week-swipe-hint|planner-week-toolbar|planner-workspace)$",
              // Plugin-owned CSS selectors in meeting_notes.css.
              "^meeting-(?:actions(?:-end)?|button|close|destination|dialog(?:-position|-header)?|field|muted|option|overlay|primary|recording|settings|status|title|toolbar)$",
              "^kuku-task-checkbox(?:__input|__control)?$",
              "^kuku-markdown-task-list$",
              "^kuku-markdown-task-item(?:-content)?$",
              "^kuku-md-code-fence$",
              "^kuku-ai-composer-textarea$",
              "^kuku-chat-(?:fade-dots|thinking-text)$",
              "^kuku-ai-tools-(?:details|chevron)$",
              "^kuku-cm-(?:separator|hairline)$",
              "^kuku-resize-grip(?:--col|--row)?$"
            ]
          }
        ],
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-restricted-classes": [
          "error",
          {
            "restrict": [
              {
                "message": "Do not use px units. Use rem instead.",
                "pattern": "^((?:[a-zA-Z0-9:/_-]*:)?[a-zA-Z0-9_/-]*-)\\[(\\d+(?:\\.\\d+)?)px\\](\\/[0-9]{1,3})?$"
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "unicorn/no-array-sort": "off"
  },
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "src/index.css",
      "rootFontSize": 16
    }
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2022": true,
    "node": true
  }
}
